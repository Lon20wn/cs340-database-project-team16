<h1>Clinics</h1>

{{!--
Implementation summary:
This page follows the same Step 3 draft pattern as the other entity pages so
the project UI stays consistent across all tables.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Clinics</h2>
  <p>Displays all clinic locations in the system.</p>
  {{!-- Static sample rows are acceptable for Step 3 Draft. --}}
  <table class="clinics-table">
    <thead>
      {{! For the table header row, we print the DB attribute names}}
      <tr>
        {{#each clinic.[0]}}
        <th>
          {{@key}}
        </th>
        {{/each}}
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{! For each row, print the clinicID and city}}
      {{#each clinic}}
      <tr>
        <td>{{this.clinicID}}</td>
        <td>{{this.city}}</td>

        {{! DELETE form}}
        <form id="delete_clinic_form" method="POST" action="/clinics/delete">
          <input type="hidden" name="delete_clinicID" value="{{this.clinicID}}" />
          <td>
            <button type="submit">
              Delete
            </button>
          </td>
        </form>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Add a Clinic</h2>
  {{!-- Field names match the Clinics DML insert query. --}}
  <form class="'cuForm" id="create_clinic_form" method="POST" action="/clinics/create">
    <label for="create_city">City:</label>
    <input type="text" id="create_city" name="create_city" required />

    <input type="submit" value="Create Clinic" />
  </form>
</div>

<!-- UPDATE -->
<div class="card">
  <h2>Update a Clinic</h2>
  {{!-- Update form is UI-only for this Step 3 draft. --}}
  <form class='cuForm' id='update_clinic' method="POST" action="/clinics/update">
    <label for="update_clinicID">Clinic to Update:</label>
    <select id="update_clinicID" name="update_clinicID" required>
      <option value="" disabled selected>Select a clinic</option>
      {{#each clinic}}
      <option value="{{this.clinicID}}" required>
        {{this.clinicID}} - {{this.city}}
      </option>
      {{/each}}
    </select>

    <label for="update_city">City:</label>
    <input type="text" id="update_city" name="update_city" />

    <input type="submit" value="Update Clinic" />
  </form>
</div>