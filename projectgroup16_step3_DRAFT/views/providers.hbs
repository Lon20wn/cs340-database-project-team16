<!-- CREATE -->
<div class="card">
  <h2> Add a Provider</h2>
  {{!-- Field names reflect the DML Add Provider query. --}}
  <form action="/providers/add" method="POST">
    <label for="create_providerID">Provider ID:</label>
    <input type="number" id="create_providerID" name="providerID" min="100" required />

    <label for="create_firstName">First Name:</label>
    <input type="text" id="create_firstName" name="firstName" required />

    <label for="create_lastName">Last Name:</label>
    <input type="text" id="create_lastName" name="lastName" required />

    <label for="create_startDate">Start Date:</label>
    <input type="date" id="create_startDate" name="startDate" required />

    <label for="create_title">Title:</label>
    <select id="create_title" name="title" required>
      <option value="" disabled selected>Select a title</option>
      <option value="Doctor">Doctor</option>
      <option value="Nurse">Nurse</option>
      <option value="Midwife">Midwife</option>
    </select>

    <input type="submit" value="Add" />
  </form>
</div>

