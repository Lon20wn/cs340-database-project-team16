<h1>Appointment Types</h1>

{{!--
Implementation summary:
This page shows planned CRUD support for AppointmentTypes using schema-aligned
sample values from the DDL and field naming consistent with the DML.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Appointment Types</h2>
  <p>Displays the appointment type catalog used when scheduling appointments.</p>
  <div class="table-scroll">
    <table class="appointment-types-table">
      <thead> {{! For the table header row, we print the DB attribute names }}
        <tr>
          {{#each appointment_types.[0]}}
          <th>
            {{@key}}
          </th>
          {{/each}}
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{! For each row, print the typeID, description, and durationInMinutes }}
        {{#each appointment_types}}
        <tr>
          <td>{{this.typeID}}</td>
          <td>{{this.description}}</td>
          <td>{{this.durationInMinutes}}</td>

          
            {{! DELETE form }}
            <form id='delete_appointment_type_form' method="POST" action='/appointment-types/delete'>
              <input type="hidden" name="delete_typeID" value="{{this.typeID}}" />
              <td>
                <button type='submit'>
                Delete
                </button>
              </td>
            </form>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Create an Appointment Type</h2>
  {{!-- Field names reflect the DML Add Appointment Type query. --}}
  <form class='cuForm' id="create_appointment_type_form" method="POST" action='/appointment-types/create'>
    <label for="create_typeID">Type ID:</label>
    <input type="text" id="create_typeID" name="create_typeID" maxlength="10" required />

    <label for="create_description">Description:</label>
    <input type="text" id="create_description" name="create_description" required />

    <label for="create_durationInMinutes">Duration (minutes):</label>
    <input type="number" id="create_durationInMinutes" name="create_durationInMinutes" min="1" required />

    <input type="submit" value="Create Appointment Type" />
  </form>
</div>

<!-- UPDATE -->
<div class="card">
  <h2>Update an Appointment Type</h2>
  {{!-- Update form remains UI-only for Step 3 Draft. --}}
  <form class='cuForm' id="update_appointment_type_from" method="POST" action='/appointment-types/update'>
    <label for="update_typeID_lookup">Appointment Type to Update:</label>
    <select id="update_typeID_lookup" name="update_typeID" required>
      <option value="" disabled selected>Select an appointment type</option>
      {{#each appointment_types}}
      <option value="{{this.typeID}}" required>
        {{this.typeID}} - {{this.description}}
      </option>
      {{/each}}
    </select>

    <label for="update_description">Description:</label>
    <input type="text" id="update_description" name="update_description" />

    <label for="update_durationInMinutes">Duration (minutes):</label>
    <input type="number" id="update_durationInMinutes" name="update_durationInMinutes" min="1" />

    <input type="submit" value="Update Appointment Type" />
  </form>
</div>