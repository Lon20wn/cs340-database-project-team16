<h1>Appointments</h1>

{{!--
Implementation summary:
This page was expanded beyond the minimal placeholder so reviewers can clearly
see planned CRUD coverage for the Appointments entity.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Appointments</h2>
  <p>Displays all appointment records in the system.</p>
  {{!--
  Step 3 note:
  This table shows static sample rows for the draft UI.
  Column names align with Appointments table attributes in DDL/DML.
  --}}
  <p class="small-note">Edit/Delete buttons are placeholders for later project steps.</p>
  <div class="table-scroll">
    <table>
      <thead>
        {{! For the table header row, we print th DB attribute names }}
        <tr>
          {{#each appointments.[0]}}
          <th>
            {{@key}}
          </th>
          {{/each}}
          <th></th>
      </thead>
      <tbody>
        {{! For each row, print the appointmentID, apptDateTime, apptStatus, typeID, patientID, providerID, and clinicID
        }}
        {{#each appointments}}
        <tr>
          <td>{{this.appointmentID}}</td>
          <td>{{this.apptDateTime}}</td>
          <td>{{this.apptStatus}}</td>
          <td>{{this.typeID}}</td>
          <td>{{this.patientID}}</td>
          <td>{{this.providerID}}</td>
          <td>{{this.clinicID}}</td>

          {{! DELETE form }}
          <form id="delete_appointment_form" method="POST" action="/appointments/delete">
            <input type="hidden" name="delete_appointmentID" value="{{this.appointmentID}}" />
            <input type="hidden" name="delete_apptDateTime" value="{{this.apptDateTime}}" />
            <td>
              <button type="submit">
                Delete
              </button>
            </td>
          </form>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Create a New Appointment</h2>
  {{!--
  Step 3 note:
  Form field names are aligned to DML variable intent (apptDateTime,
  apptStatus, typeID, patientID, providerID, clinicID).
  --}}
  <form class='cuForm' id='create_appointment_form' method='POST' action="/appointments/create">
    {{!-- Date and time are collected together to reflect apptDateTime in SQL. --}}
    <label for="create_apptDateTime">Appointment Date/Time:</label>
    <input type="datetime-local" id="create_apptDateTime" name="create_apptDateTime" required />

    <label for="create_apptStatus">Appointment Status:</label>
    <select id="create_apptStatus" name="create_apptStatus" required>
      <option value="Scheduled" selected>Scheduled</option>
    </select>

    <label for="create_typeID">Appointment Type:</label>
    <select id="create_typeID" name="create_typeID" required>
      <option value="" disabled selected>Select an appointment type</option>
      {{#each appointment_types}}
      <option value='{{this.typeID}}' required>{{this.typeID}}</option>
      {{/each}}
    </select>

    <label for="create_patientID">Patient:</label>
    <select id="create_patientID" name="create_patientID" required>
      <option value="" disabled selected>Select a patient</option>
      {{#each patient_IDs}}
      <option value="{{this.patientID}}" required>{{this.patientID}} - {{this.firstName}} {{this.lastName}}</option>
      {{/each}}
    </select>

    <label for="create_providerID">Provider:</label>
    <select id="create_providerID" name="create_providerID" required>
      <option value="" disabled selected>Select a provider</option>
      {{#each provider_IDs}}
      <option value="{{this.providerID}}" required>{{this.providerID}} - {{this.title}} {{this.lastName}}</option>
      {{/each}}
    </select>

    <label for="create_clinicID">Clinic:</label>
    <select id="create_clinicID" name="create_clinicID" required>
      <option value="" disabled selected>Select a clinic</option>
      {{#each clinic_IDs}}
      <option value="{{this.clinicID}}" required>{{this.clinicID}} - {{this.city}}</option>
      {{/each}}
    </select>

    <input type="submit" value="Create Appointment" />
  </form>
</div>

<!-- UPDATE -->
<div class="card">
  <h2>Update an Appointment</h2>
  {{!--
  Step 3 note:
  Update form is UI-only in this draft. Backend update logic is implemented
  in later steps.
  --}}
  <form class="cuForm" id="update_appointment_form" method="POST" action="/appointments/update">
    {{!-- Update options mirror the DML update query inputs for this entity. --}}
    <label for="update_appointmentID">Appointment to Update:</label>
    <select id="update_appointmentID" name="update_appointmentID" required>
      <option value="" disabled selected>Select an appointment</option>
      {{#each appointments}}
      <option value="{{this.appointmentID}}" required>{{this.appointmentID}} - {{this.apptDateTime}}</option>
      {{/each}}
    </select>

    <label for="update_apptDateTime">Appointment Date/Time:</label>
    <input type="datetime-local" id="update_apptDateTime" name="update_apptDateTime" required/>

    <label for="update_apptStatus">Appointment Status:</label>
    <select id="update_apptStatus" name="update_apptStatus" required>
      <option value="" disabled selected>Select status</option>
      <option value="Scheduled">Scheduled</option>
      <option value="Completed">Completed</option>
      <option value="Cancelled">Cancelled</option>
      <option value="Voided">Voided -- use to delete</option>
    </select>

    <label for="update_typeID">Appointment Type:</label>
    <select id="update_typeID" name="update_typeID">
      <option value="" disabled selected>Select an appointment type</option>
      {{#each appointment_types}}
      <option value='{{this.typeID}}' required>{{this.typeID}}</option>
      {{/each}}
    </select>
    
    <label for="update_patientID">Patient:</label>
    <select id="update_patientID" name="update_patientID">
      <option value="" disabled selected>Select a patient</option>
      {{#each patient_IDs}}
      <option value="{{this.patientID}}" required>{{this.patientID}} - {{this.firstName}} {{this.lastName}}</option>
      {{/each}}
    </select>

    <label for="update_providerID">Provider:</label>
    <select id="update_providerID" name="update_providerID">
      <option value="" disabled selected>Select a provider</option>
      {{#each provider_IDs}}
      <option value="{{this.providerID}}" required>{{this.providerID}} - {{this.title}} {{this.lastName}}</option>"
      {{/each}}
    </select>

    <label for="update_clinicID">Clinic:</label>
    <select id="update_clinicID" name="update_clinicID">
      <option value="" disabled selected>Select a clinic</option>
      {{#each clinic_IDs}}
      <option value="{{this.clinicID}}" required>{{this.clinicID}} - {{this.city}}</option>
      {{/each}}
    </select>

    <input type="submit" value="Update Appointment" />
  </form>
</div>

