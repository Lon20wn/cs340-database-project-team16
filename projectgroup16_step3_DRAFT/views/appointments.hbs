<h1>Appointments</h1>

{{!--
Implementation summary:
This page was expanded beyond the minimal placeholder so reviewers can clearly
see planned CRUD coverage for the Appointments entity.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Appointments</h2>
  <p>Displays all appointment records in the system.</p>
  {{!--
  Step 3 note:
  This table shows static sample rows for the draft UI.
  Column names align with Appointments table attributes in DDL/DML.
  --}}
  <p class="small-note">Edit/Delete buttons are placeholders for later project steps.</p>
  <div class="table-scroll">
    <table>
      <thead>
       {{! For the table header row, we print th DB attribute names }}
        <tr>
          {{#each appointments.[0]}}
          <th>
            {{@key}}
          </th>
          {{/each}}
          <th></th>
      </thead>
      <tbody>
        {{! For each row, print the appointmentID, apptDateTime, apptStatus, typeID, patientID, providerID, and clinicID
        }}
        {{#each appointments}}
        <tr>
          <td>{{this.appointmentID}}</td>
          <td>{{this.apptDateTime}}</td>
          <td>{{this.apptStatus}}</td>
          <td>{{this.typeID}}</td>
          <td>{{this.patientID}}</td>
          <td>{{this.providerID}}</td>
          <td>{{this.clinicID}}</td>

          {{! DELETE form }}
          <form id="delete_appointment_form" method="POST" action="/appointments/delete">
            <input type="hidden" name="delete_appointmentID" value="{{this.appointmentID}}" />
            <input type="hidden" name="delete_apptDateTime" value="{{this.apptDateTime}}" />
            <td>
              <button type="submit">
                Delete
              </button>
            </td>
          </form>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Create a New Appointment</h2>
  {{!--
  Step 3 note:
  Form field names are aligned to DML variable intent (apptDateTime,
  apptStatus, typeID, patientID, providerID, clinicID).
  --}}
  <form action="/appointments/add" method="POST">
    {{!-- Date and time are collected together to reflect apptDateTime in SQL. --}}
    <label for="create_apptDateTime">Appointment Date/Time:</label>
    <input type="datetime-local" id="create_apptDateTime" name="apptDateTime" required />

    <label for="create_apptStatus">Appointment Status:</label>
    <select id="create_apptStatus" name="apptStatus" required>
      <option value="" disabled selected>Select status</option>
      <option value="Scheduled">Scheduled</option>
      <option value="Completed">Completed</option>
      <option value="Cancelled">Cancelled</option>
    </select>

    <label for="create_typeID">Appointment Type:</label>
    <select id="create_typeID" name="typeID" required>
      <option value="" disabled selected>Select an appointment type</option>
      <option value="NP">NP - New Patient</option>
      <option value="OVR">OVR - Office Visit Regular</option>
      <option value="PROC">PROC - Procedure</option>
      <option value="NOB">NOB - New OB</option>
      <option value="OBR">OBR - OB Regular</option>
    </select>

    <label for="create_patientID">Patient:</label>
    <select id="create_patientID" name="patientID" required>
      <option value="" disabled selected>Select a patient</option>
      <option value="1">1 - Nyota Uhura</option>
      <option value="2">2 - Jadzia Dax</option>
      <option value="3">3 - B'Elanna Torres</option>
      <option value="4">4 - Kira Nerys</option>
      <option value="5">5 - Beckett Mariner</option>
    </select>

    <label for="create_providerID">Provider:</label>
    <select id="create_providerID" name="providerID" required>
      <option value="" disabled selected>Select a provider</option>
      <option value="113">113 - Beverly Crusher</option>
      <option value="249">249 - Christine Chapel</option>
      <option value="368">368 - Julienne Bashir</option>
      <option value="102">102 - Katherine Pulaski</option>
    </select>

    <label for="create_clinicID">Clinic:</label>
    <select id="create_clinicID" name="clinicID" required>
      <option value="" disabled selected>Select a clinic</option>
      <option value="1">1 - Corvallis</option>
      <option value="2">2 - Salem</option>
      <option value="3">3 - Eugene</option>
    </select>

    <input type="submit" value="Create Appointment" />
  </form>
</div>

