<h1>Patients</h1>

<!-- READ -->
<div class="card">
  <h2>Browse Existing Patients</h2>
  <p>Displays list of existing patients and their information.</p>
  
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Patient ID</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Date of Birth</th>
          <th>Address</th>
          <th>Language</th>
          <th>Insurance Payor</th>
        <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each patients}}
        <tr>
          <td>{{this.patientID}}</td>
          <td>{{this.firstName}}</td>
          <td>{{this.lastName}}</td>
          <td>{{this.dateOfBirth}}</td>
          <td>{{this.address}}</td>
          <td>{{this.language}}</td>
          <td>{{this.insurancePayor}}</td>
          <form id="delete_patient_form" method="POST" action="/patients/delete">
            <input type="hidden" name="delete_patientID" value="{{this.patientID}}" />
            <td>
              <button type="submit">
                Delete
              </button>
            </td>
          </form>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- CREATE -->
<div class="card">
  <h2> Add A New Patient</h2>
  <p> Add a new patient to the database by filling out the form below.</p>
  {{!-- Field names reflect the DML Add Patient query. --}}
  <form class="cuForm" action="/patients/create" method="POST">
    <label for="create_firstName">First Name:</label>
    <input type="text" id="create_firstName" name="create_firstName" required />

    <label for="create_lastName">Last Name:</label>
    <input type="text" id="create_lastName" name="create_lastName" required />

    <label for="create_dateOfBirth">Date of Birth:</label>
    <input type="date" id="create_dateOfBirth" name="create_dateOfBirth" required />

    <label for="create_address">Address:</label>
    <input type="text" id="create_address" name="create_address" required />

    <label for="create_language">Language:</label>
    <input type="text" id="create_language" name="create_language" required />

    <label for="create_insurancePayor">Insurance Payor:</label>
    <input type="text" id="create_insurancePayor" name="create_insurancePayor" required />

    <input type="submit" value="Add Patient" />
  </form>
</div>

<!-- UPDATE -->
<div class="card">
  <h2>Update an Existing Patient</h2>
  <p>Update any or all of an existing patient's information by filling out the form below.</p>
  <form class="cuForm" action="/patients/update" method="POST">
    <label for="update_patientID">Patient to Update:</label>
    <select id="update_patientID" name="update_patientID" required>
      <option value="">Select a Patient</option>
      {{#each patients}}
      <option value="{{this.patientID}}">
        {{this.patientID}} - {{this.firstName}} {{this.lastName}}
      </option>
      {{/each}}
    </select>

    <label for="update_firstName">First Name:</label>
    <input type="text" id="update_firstName" name="update_firstName" />

    <label for="update_lastName">Last Name:</label>
    <input type="text" id="update_lastName" name="update_lastName" />

    <label for="update_dateOfBirth">Date of Birth:</label>
    <input type="date" id="update_dateOfBirth" name="update_dateOfBirth" />

    <label for="update_address">Address:</label>
    <input type="text" id="update_address" name="update_address" />

    <label for="update_language">Language:</label>
    <input type="text" id="update_language" name="update_language" />

    <label for="update_insurancePayor">Insurance Payor:</label>
    <input type="text" id="update_insurancePayor" name="update_insurancePayor" />

    <input type="submit" value="Update Patient" />
  </form>
</div>

<!-- DELETE -->
<div class="card">
  <h2>Delete an Existing Patient</h2>
  <p>Permanetly remove a patient from the database by selecting them below.</p>
  {{!-- Delete remains a simple selector + submit UI for this draft phase. --}}
  <form class="cuForm" action="/patients/delete" method="POST">
    <label for="delete_patientID">Patient to Delete:</label>
    <select id="delete_patientID" name="delete_patientID" required>
      <option value="">Select a Patient</option>
      {{#each patients}}
      <option value="{{this.patientID}}">
        {{this.patientID}} - {{this.firstName}} {{this.lastName}}
      </option>
      {{/each}}
    </select>

    <input type="submit" value="Delete Patient" />
  </form>
</div>