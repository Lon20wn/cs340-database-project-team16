<h1>Patients</h1>

<!-- READ -->
<div class="card">
  <h2>Browse Patients</h2>
  <p>Displays all patients stored in the database.</p>
  <table>
    <thead>
      <tr><th>ID</th><th>First Name</th><th>Last Name</th><th>Date of Birth</th><th>Address</th><th>Language</th><th>Insurance Payor</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <tr><td>1</td><td>Nyota</td><td>Uhura</td><td>1972-03-26</td><td>1701 Enterprise Drive Corvallis, OR 97330</td><td>Swahili</td><td>United Healthcare</td><td><button>Edit</button> <button>Delete</button></td></tr>
      <tr><td>2</td><td>Jadzia</td><td>Dax</td><td>1988-01-01</td><td>10 Forward Avenue Corvallis, OR 97330</td><td>English</td><td>Self-pay</td><td><button>Edit</button> <button>Delete</button></td></tr>
    </tbody>
  </table>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Add a New Patient</h2>
  <form action="/patients/add" method="POST">
    <label for="firstName">First Name:</label>
    <input type="text" id="firstName" name="firstName" required />

    <label for="lastName">Last Name:</label>
    <input type="text" id="lastName" name="lastName" required />

    <label for="dateOfBirth">Date of Birth:</label>
    <input type="date" id="dateOfBirth" name="dateOfBirth" required />

    <label for="address">Address:</label>
    <input type="text" id="address" name="address" required />

    <label for="language">Language:</label>
    <input type="text" id="language" name="language" required />

    <label for="insurancePayor">Insurance Payor:</label>
    <input type="text" id="insurancePayor" name="insurancePayor" required />

    <input type="submit" value="Add Patient" />
  </form>
</div>

<!-- UPDATE -->
<div class="card">
  <h2>Update a Patient</h2>
  <form action="/patients/update" method="POST">
    <label for="update_patientID">Select Patient to Update:</label>
    <select id="update_patientID" name="patientID" required>
      <option value="" disabled selected>Select a patient</option>
      <option value="1">1 - Nyota Uhura</option>
      <option value="2">2 - Jadzia Dax</option>
    </select>

    <label for="update_firstName">First Name:</label>
    <input type="text" id="update_firstName" name="firstName" />

    <label for="update_lastName">Last Name:</label>
    <input type="text" id="update_lastName" name="lastName" />

    <label for="update_dateOfBirth">Date of Birth:</label>
    <input type="date" id="update_dateOfBirth" name="dateOfBirth" />

    <label for="update_address">Address:</label>
    <input type="text" id="update_address" name="address" />

    <label for="update_language">Language:</label>
    <input type="text" id="update_language" name="language" />

    <label for="update_insurancePayor">Insurance Payor:</label>
    <input type="text" id="update_insurancePayor" name="insurancePayor" />

    <input type="submit" value="Update Patient" />
  </form>
</div>

<!-- DELETE -->
<div class="card">
  <h2>Delete a Patient</h2>
  <form action="/patients/delete" method="POST">
    <label for="delete_patientID">Select Patient to Delete:</label>
    <select id="delete_patientID" name="patientID" required>
      <option value="" disabled selected>Select a patient</option>
      <option value="1">1 - Nyota Uhura</option>
      <option value="2">2 - Jadzia Dax</option>
    </select>
    <input type="submit" value="Delete Patient" />
  </form>
</div>
