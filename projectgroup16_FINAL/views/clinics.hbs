<h1>Clinics</h1>

{{!--
Implementation summary:
This page follows the same Step 3 draft pattern as the other entity pages so
the project UI stays consistent across all tables.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Clinics</h2>
  <p>Displays all clinic locations in the system.</p>
  {{!-- Static sample rows are acceptable for Step 3 Draft. --}}
  <table class="clinics-table">
    <thead>
      {{! For the table header row, we print the DB attribute names}}
      <tr>
        {{#each clinic.[0]}}
        <th>
          {{@key}}
        </th>
        {{/each}}
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{! For each row, print the clinicID and city}}
      {{#each clinic}}
      <tr>
        <td>{{this.clinicID}}</td>
        <td>{{this.city}}</td>
        <td>
          <button class="btn-edit" type="button"
            data-id="{{this.clinicID}}"
            data-city="{{this.city}}">
            Edit
          </button>
          <button class="btn-delete" type="button"
            data-id="{{this.clinicID}}"
            data-name="{{this.city}}">
            Delete
          </button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Add a Clinic</h2>
  {{!-- Field names match the Clinics DML insert query. --}}
  <form class="'cuForm" id="create_clinic_form" method="POST" action="/clinics/create">
    <label for="create_city">City:</label>
    <input type="text" id="create_city" name="create_city" required />

    <input type="submit" value="Create Clinic" />
  </form>
</div>

