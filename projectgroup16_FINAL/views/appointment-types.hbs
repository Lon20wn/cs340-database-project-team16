<h1>Appointment Types</h1>

{{!--
Implementation summary:
This page shows planned CRUD support for AppointmentTypes using schema-aligned
sample values from the DDL and field naming consistent with the DML.
--}}

<!-- READ -->
<div class="card">
  <h2>Browse Appointment Types</h2>
  <p>Displays the appointment type catalog used when scheduling appointments.</p>
  <div class="table-scroll">
    <table class="appointment-types-table">
      <thead>
        <tr>
          <th>Type ID</th>
          <th>Description</th>
          <th>Duration (minutes)</th>
          <th></th>
        </tr>

      </thead>
      <tbody>
        {{! For each row, print the typeID, description, and durationInMinutes }}
        {{#each appointment_types}}
        <tr>
          <td>{{this.typeID}}</td>
          <td>{{this.description}}</td>
          <td>{{this.durationInMinutes}}</td>
          <td>
            <button class="btn-edit" type="button"
              data-id="{{this.typeID}}"
              data-description="{{this.description}}"
              data-duration="{{this.durationInMinutes}}">
              Edit
            </button>
            <button class="btn-delete" type="button"
              data-id="{{this.typeID}}"
              data-name="{{this.typeID}} - {{this.description}}">
              Delete
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- CREATE -->
<div class="card">
  <h2>Create an Appointment Type</h2>
  {{!-- Field names reflect the DML Add Appointment Type query. --}}
  <form class='cuForm' id="create_appointment_type_form" method="POST" action='/appointment-types/create'>
    <label for="create_typeID">Type ID:</label>
    <input type="text" id="create_typeID" name="create_typeID" maxlength="10" required />

    <label for="create_description">Description:</label>
    <input type="text" id="create_description" name="create_description" required />

    <label for="create_durationInMinutes">Duration (minutes):</label>
    <input type="number" id="create_durationInMinutes" name="create_durationInMinutes" min="1" required />

    <input type="submit" value="Create Appointment Type" />
  </form>
</div>

